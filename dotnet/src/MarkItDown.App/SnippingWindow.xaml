<Window x:Class="MarkItDown.App.SnippingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Text Extractor"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#55000000"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        KeyDown="Window_KeyDown">

    <Canvas x:Name="OverlayCanvas">
        <!-- Selection Box with Glowing Border -->
        <Border x:Name="SelectionBox"
                BorderBrush="#818CF8"
                BorderThickness="2"
                Background="#226366F1"
                CornerRadius="4"
                Visibility="Collapsed" />

        <!-- Hint Text at the top -->
        <Border Background="#CC0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,6" Canvas.Top="20" Canvas.Left="40">
            <TextBlock Text="🔍 Matnni tanlash uchun sichqoncha bilan sohani belgilang (Bekor qilish uchun ESC bosing)" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" />
        </Border>
    </Canvas>
</Window>
